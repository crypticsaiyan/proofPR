# ProofPR configuration. Copy to .env and fill in. Never commit .env.
# Every key is documented in docs/CONFIGURATION.md.

# --- Runtime -----------------------------------------------------------------
PROOFPR_ENV=dev                       # dev | eval | prod
PROOFPR_LOG_LEVEL=INFO
PROOFPR_CONFIG_FILE=config/proofpr.toml
PROOFPR_DB_PATH=var/proofpr.db
PROOFPR_ARMS=proofpr                  # proofpr | no_gate (baseline evaluation arm)

# --- Models (OpenRouter) -----------------------------------------------------
OPENROUTER_API_KEY=
MODEL_CHEAP=anthropic/claude-haiku-4.5
MODEL_STRONG=anthropic/claude-opus-5

# --- Discord -----------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INTAKE_CHANNEL_ID=
DISCORD_EVAL_CHANNEL_ID=

# --- GitHub (fine-grained PAT, target repo only) -----------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# --- Linear ------------------------------------------------------------------
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=

# --- Caps --------------------------------------------------------------------
MAX_RUNS=200
MAX_SPEND_USD=25
MAX_PATCH_ATTEMPTS=3
SANDBOX_TIMEOUT_SECONDS=60

# --- Observability (optional) ------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=proofpr
